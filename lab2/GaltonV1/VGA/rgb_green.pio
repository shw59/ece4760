;
; Hunter Adams (vha3@cornell.edu)
; RGB generation for VGA driver
; mod by Bruce Land for 16 colors
; mod for 1 bit/pixel, green only -- 32 pixels per FIFO word, LSB first
;
; Each pixel bit goes straight to ONE pin (VGA green hi-bit, GPIO 19).
; The other color pins are never driven, so a 1 bit is green, 0 is black.

; Program name
.program rgb_green
; pixelhold sets the pixel period: (2 + pixelhold) cycles per pixel
; must be 10 cycles/pixel at 250 MHz -> 8 (150 MHz -> 4)
.define pixelhold 8
.define PUBLIC vid_freq 250

pull block 					; Pull pixel count from FIFO (only once)
out y, 32					; Copy count to y AND empty OSR so autopull loads pixels
.wrap_target

set pins, 0 				; Zero green pin in blanking
mov x, y 					; Initialize counter variable

wait 1 irq 1 [3]			; Wait for vsync active mode (starts 5 cycles after execution)

colorout:
	out pins, 1 [pixelhold]	; Push one pixel bit to the green pin (autopull every 32 pixels)
	jmp x-- colorout		; Stay here thru horizontal active mode

.wrap

% c-sdk {
static inline void rgb_green_program_init(PIO pio, uint sm, uint offset, uint pin) {

    pio_sm_config c = rgb_green_program_get_default_config(offset);

    // SET and OUT pin groups are a single pin
    sm_config_set_set_pins(&c, pin, 1);
    sm_config_set_out_pins(&c, pin, 1);

    // shift right (pixel x lives in bit x&7 of byte x>>3), autopull every 32 bits
    sm_config_set_out_shift(&c, true, true, 32);

    // longer FIFO to avoid bursty data
    sm_config_set_fifo_join (&c, PIO_FIFO_JOIN_TX) ;

    // only the one green pin is connected to the PIO
    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);

    pio_sm_init(pio, sm, offset, &c);
}
%}
